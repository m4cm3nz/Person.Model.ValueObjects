@page "/not-found"
@layout MainLayout

<PageTitle>Não encontrado</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-16">
    <MudText Typo="Typo.h4" GutterBottom="true">Página não encontrada</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
        O conteúdo que você procura não existe.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Home">Voltar ao início</MudButton>
</MudContainer>
